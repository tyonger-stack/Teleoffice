{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    // resolve workspace types from this checkout's sources: in a git worktree
    // node_modules is a symlink into the main checkout, so bare specifiers
    // would typecheck against the other checkout's (possibly stale) types
    "paths": {
      "@teleoffice/ai-provider": ["../ai-provider/src/index.ts"],
      "@teleoffice/electron-utils/remote-image": ["../electron-utils/src/remote-image.ts"],
      "@teleoffice/electron-utils/safe-remote-url": ["../electron-utils/src/safe-remote-url.ts"],
      "@teleoffice/electron-utils/generated-images": ["../electron-utils/src/generated-images.ts"]
    }
  },
  "include": ["src", "tests"]
}

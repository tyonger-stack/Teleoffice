{
  "name": "@teleoffice/shell",
  "productName": "TeleOffice",
  "version": "0.13.3",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tyonger-stack/Teleoffice",
  "private": true,
  "description": "Unified TeleOffice shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "teleoffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@teleoffice/agent-core": "*",
    "@teleoffice/ai-provider": "*",
    "@teleoffice/ai-search": "*",
    "@teleoffice/docs": "*",
    "@teleoffice/docx-engine": "*",
    "@teleoffice/electron-utils": "*",
    "@teleoffice/cli": "*",
    "@teleoffice/i18n": "*",
    "@teleoffice/pipelines": "*",
    "@teleoffice/pptx-engine": "*",
    "@teleoffice/pptx-render": "*",
    "@teleoffice/sheets": "*",
    "@teleoffice/slides": "*",
    "@teleoffice/ui": "*",
    "@teleoffice/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "TeleOffice"
}
